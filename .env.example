# ==============================================================================
# DarkOps AI — Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and adjust variables for your local setup.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=darkops_user
POSTGRES_PASSWORD=darkops_password
POSTGRES_DB=darkops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://darkops_user:darkops_password@localhost:5432/darkops_db

# ------------------------------------------------------------------------------
# Operational API (Node.js + Express + TypeScript)
# ------------------------------------------------------------------------------
OPERATIONAL_API_PORT=3000
OPERATIONAL_API_HOST=0.0.0.0
OPERATIONAL_API_URL=http://localhost:3000
JWT_SECRET=development_jwt_secret_change_in_production_32chars_min
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Optimization Service (Python + FastAPI + OR-Tools)
# ------------------------------------------------------------------------------
OPTIMIZATION_SERVICE_PORT=8000
OPTIMIZATION_SERVICE_HOST=0.0.0.0
OPTIMIZATION_SERVICE_URL=http://localhost:8000
OPTIMIZATION_LOG_LEVEL=info
OPTIMIZATION_SOLVER_TIMEOUT_SECONDS=5

# ------------------------------------------------------------------------------
# Simulation Worker (Python)
# ------------------------------------------------------------------------------
SIMULATION_WORKER_LOG_LEVEL=info
DEFAULT_RANDOM_SEED=42
SIMULATION_DEFAULT_HORIZON_HOURS=24

# ------------------------------------------------------------------------------
# Operations Dashboard (React + Vite + Tailwind CSS)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_APP_TITLE="DarkOps AI Operations Control Center"

# ------------------------------------------------------------------------------
# AI Operations Copilot (Optional / Phase 11)
# ------------------------------------------------------------------------------
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=your_api_key_here
