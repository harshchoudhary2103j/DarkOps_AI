{
  "openapi": "3.0.3",
  "info": {
    "title": "DarkOps AI Operational Catalog API",
    "version": "1.0.0",
    "description": "Standardized REST endpoints for managing structural dark-store catalog entities: Stores, Service Zones, Products, SKUs, Suppliers, and Warehouse Layout Graphs."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "AdminKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Key"
      }
    },
    "schemas": {
      "ErrorDetails": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "example": "VALIDATION_ERROR" },
          "message": { "type": "string", "example": "Request payload validation failed" },
          "details": { "type": "object" },
          "correlationId": { "type": "string", "format": "uuid" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetails" }
        }
      },
      "GeoJSONPolygon": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["Polygon"] },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 4
            }
          }
        }
      },
      "Store": {
        "type": "object",
        "required": ["id", "name", "status", "latitude", "longitude", "service_area", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "MAINTENANCE"] },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "service_area": { "$ref": "#/components/schemas/GeoJSONPolygon" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ServiceZone": {
        "type": "object",
        "required": ["id", "store_id", "name", "boundary", "status", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "store_id": { "type": "string" },
          "name": { "type": "string" },
          "boundary": { "$ref": "#/components/schemas/GeoJSONPolygon" },
          "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Product": {
        "type": "object",
        "required": ["id", "name", "category", "status", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["ACTIVE", "DISCONTINUED"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "SKU": {
        "type": "object",
        "required": ["id", "product_id", "sku_code", "pack_size", "shelf_life_days", "storage_temp", "unit_price", "currency", "status", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "product_id": { "type": "string" },
          "sku_code": { "type": "string" },
          "pack_size": { "type": "integer", "minimum": 1 },
          "shelf_life_days": { "type": "integer", "minimum": 1 },
          "storage_temp": {
            "type": "object",
            "required": ["unit", "min", "max"],
            "properties": {
              "unit": { "type": "string", "enum": ["CELSIUS", "FAHRENHEIT"] },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "zone": { "type": "string", "enum": ["AMBIENT", "CHILLED", "FROZEN"] }
            }
          },
          "unit_price": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "example": "USD" },
          "status": { "type": "string", "enum": ["ACTIVE", "DISCONTINUED"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Supplier": {
        "type": "object",
        "required": ["id", "name", "default_lead_time_hours", "default_moq", "review_schedule", "status", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "default_lead_time_hours": { "type": "integer", "minimum": 1 },
          "default_moq": { "type": "integer", "minimum": 1 },
          "review_schedule": {
            "type": "object",
            "required": ["cadence"],
            "properties": {
              "cadence": { "type": "string", "enum": ["DAILY", "WEEKLY", "BIWEEKLY", "MONTHLY"] },
              "review_time_utc": { "type": "string", "example": "08:00" },
              "days_of_week": { "type": "array", "items": { "type": "integer" } }
            }
          },
          "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "WarehouseLayout": {
        "type": "object",
        "required": ["id", "store_id", "name", "version", "status", "nodes", "edges", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string" },
          "store_id": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "ARCHIVED"] },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "x", "y", "z"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["DISPATCH_STATION", "AISLE", "SHELF", "PICK_ZONE"] },
                "aisle_id": { "type": "string", "nullable": true },
                "shelf_id": { "type": "string", "nullable": true },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from_node", "to_node", "distance", "bidirectional"],
              "properties": {
                "from_node": { "type": "string" },
                "to_node": { "type": "string" },
                "distance": { "type": "number", "minimum": 0 },
                "bidirectional": { "type": "boolean" }
              }
            }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "MetricValue": {
        "type": "object",
        "required": ["metric_name", "unit", "formula_ref", "status", "objective"],
        "properties": {
          "metric_name": { "type": "string" },
          "value": { "type": "number", "nullable": true },
          "unit": { "type": "string" },
          "formula_ref": { "type": "string" },
          "status": { "type": "string", "enum": ["AVAILABLE", "ZERO", "NOT_APPLICABLE", "INSUFFICIENT_DATA", "INVALID_EVENT_STREAM"] },
          "objective": { "type": "string", "enum": ["HIGHER_IS_BETTER", "LOWER_IS_BETTER", "NEUTRAL"] },
          "numerator": { "type": "number", "nullable": true },
          "denominator": { "type": "number", "nullable": true },
          "sample_count": { "type": "integer", "nullable": true },
          "mean": { "type": "number", "nullable": true },
          "median": { "type": "number", "nullable": true },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      },
      "EvaluationSummary": {
        "type": "object",
        "required": ["evaluation_id", "run_id", "scenario_id", "seed", "status", "simulated_duration_seconds", "evaluator_version", "formula_version", "evaluated_at", "event_count", "kpis", "disclaimer"],
        "properties": {
          "evaluation_id": { "type": "string" },
          "run_id": { "type": "string" },
          "scenario_id": { "type": "string" },
          "seed": { "type": "integer" },
          "status": { "type": "string" },
          "simulated_duration_seconds": { "type": "number" },
          "evaluator_version": { "type": "string" },
          "formula_version": { "type": "string" },
          "evaluated_at": { "type": "string", "format": "date-time" },
          "event_count": { "type": "integer" },
          "policy_identifiers": { "type": "array", "items": { "type": "string" } },
          "policy_config": { "type": "object" },
          "cost_config": { "type": "object" },
          "kpis": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/MetricValue" } },
          "data_quality_warnings": { "type": "array", "items": { "type": "string" } },
          "disclaimer": { "type": "string" }
        }
      },
      "CompareRunsRequest": {
        "type": "object",
        "required": ["baseline_run_id", "candidate_run_id"],
        "properties": {
          "baseline_run_id": { "type": "string" },
          "candidate_run_id": { "type": "string" },
          "cost_config_override": { "type": "object" }
        }
      },
      "MetricComparison": {
        "type": "object",
        "required": ["metric_name", "unit", "baseline_status", "candidate_status", "objective", "improvement_status"],
        "properties": {
          "metric_name": { "type": "string" },
          "unit": { "type": "string" },
          "baseline_value": { "type": "number", "nullable": true },
          "candidate_value": { "type": "number", "nullable": true },
          "baseline_status": { "type": "string" },
          "candidate_status": { "type": "string" },
          "absolute_difference": { "type": "number", "nullable": true },
          "percentage_change": { "type": "number", "nullable": true },
          "percentage_change_explanation": { "type": "string", "nullable": true },
          "objective": { "type": "string" },
          "is_improvement": { "type": "boolean", "nullable": true },
          "improvement_status": { "type": "string", "enum": ["IMPROVED", "DEGRADED", "UNCHANGED", "INCOMPARABLE", "CHANGED"] }
        }
      },
      "ComparisonReport": {
        "type": "object",
        "required": ["baseline_run_id", "candidate_run_id", "scenario_compatible", "duration_compatible", "cost_config_compatible", "comparisons", "disclaimer"],
        "properties": {
          "baseline_run_id": { "type": "string" },
          "candidate_run_id": { "type": "string" },
          "scenario_compatible": { "type": "boolean" },
          "duration_compatible": { "type": "boolean" },
          "cost_config_compatible": { "type": "boolean" },
          "policy_variation_detected": { "type": "boolean" },
          "comparisons": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/MetricComparison" } },
          "compatibility_warnings": { "type": "array", "items": { "type": "string" } },
          "disclaimer": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health Check Probe",
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    },
    "/api/v1/stores": {
      "get": {
        "summary": "List Stores with pagination",
        "responses": {
          "200": { "description": "Paginated list of stores" }
        }
      },
      "post": {
        "summary": "Create a new Store (Admin required)",
        "security": [{ "BearerAuth": [] }, { "AdminKeyAuth": [] }],
        "responses": {
          "201": { "description": "Store created successfully" },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/api/v1/stores/{id}": {
      "get": {
        "summary": "Get store by ID",
        "responses": {
          "200": { "description": "Store details" },
          "404": { "description": "Store not found" }
        }
      },
      "patch": {
        "summary": "Update store attributes",
        "security": [{ "BearerAuth": [] }, { "AdminKeyAuth": [] }],
        "responses": {
          "200": { "description": "Store updated" }
        }
      },
      "delete": {
        "summary": "Delete store",
        "security": [{ "BearerAuth": [] }, { "AdminKeyAuth": [] }],
        "responses": {
          "200": { "description": "Store deleted" }
        }
      }
    },
    "/api/v1/service-zones": {
      "get": { "summary": "List service zones" },
      "post": { "summary": "Create service zone" }
    },
    "/api/v1/products": {
      "get": { "summary": "List products" },
      "post": { "summary": "Create product" }
    },
    "/api/v1/skus": {
      "get": { "summary": "List SKUs" },
      "post": { "summary": "Create SKU" }
    },
    "/api/v1/skus/code/{code}": {
      "get": { "summary": "Get SKU by code" }
    },
    "/api/v1/suppliers": {
      "get": { "summary": "List suppliers" },
      "post": { "summary": "Create supplier" }
    },
    "/api/v1/suppliers/{id}/skus": {
      "get": { "summary": "List SKUs provided by supplier" },
      "post": { "summary": "Link SKU to supplier with pricing and MOQ" }
    },
    "/api/v1/warehouse-layouts": {
      "post": { "summary": "Create warehouse layout graph (validates reachability)" }
    },
    "/api/v1/warehouse-layouts/{id}/activate": {
      "post": { "summary": "Activate warehouse layout for store" }
    },
    "/api/v1/inventory": {
      "get": { "summary": "List inventory positions with bounded pagination and low_stock filter" }
    },
    "/api/v1/inventory/{storeId}/{skuId}": {
      "get": { "summary": "Get inventory position for store and SKU" }
    },
    "/api/v1/inventory/initialize": {
      "post": {
        "summary": "Initialize inventory position with opening balance (Idempotency-Key required)",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/inventory/receipts": {
      "post": {
        "summary": "Receive stock from supplier (Idempotency-Key required)",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/inventory/adjustments": {
      "post": {
        "summary": "Apply manual stock adjustment (Idempotency-Key required)",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/inventory/reserve": {
      "post": {
        "summary": "Reserve available stock with row-level locking (Idempotency-Key required)",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/inventory/release": {
      "post": {
        "summary": "Release reserved stock back to available (Idempotency-Key required)",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/inventory/consume": {
      "post": {
        "summary": "Consume reserved stock upon picking (Idempotency-Key required)",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/inventory/movements": {
      "get": { "summary": "Query immutable stock movement ledger" }
    },
    "/api/v1/inventory/reconcile/{storeId}/{skuId}": {
      "get": { "summary": "Reconcile stored position balances against historical ledger movements" }
    },
    "/api/v1/inventory/recommendations": {
      "get": { "summary": "List replenishment recommendations" }
    },
    "/api/v1/inventory/recommendations/generate": {
      "post": { "summary": "Trigger threshold-based replenishment recommendations" }
    },
    "/api/v1/inventory/recommendations/{id}/approve": {
      "post": { "summary": "Approve replenishment recommendation" }
    },
    "/api/v1/inventory/recommendations/{id}/reject": {
      "post": { "summary": "Reject replenishment recommendation" }
    },
    "/api/v1/inventory/recommendations/{id}/execute": {
      "post": { "summary": "Mark replenishment recommendation as executed" }
    },
    "/api/v1/orders": {
      "post": {
        "summary": "Create customer order with lines",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }]
      },
      "get": { "summary": "List orders with status, store, and customer filtering" }
    },
    "/api/v1/orders/{orderId}": {
      "get": { "summary": "Get order details with lines and lifecycle events" }
    },
    "/api/v1/orders/{orderId}/allocate": {
      "post": {
        "summary": "Trigger single-store candidate allocation, basket reservation, and picking task creation",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/orders/{orderId}/cancel": {
      "post": {
        "summary": "Cancel order and release unconsumed reserved stock in Inventory Core",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/picking/tasks": {
      "get": { "summary": "List picking tasks with store and status filters" }
    },
    "/api/v1/picking/tasks/{taskId}": {
      "get": { "summary": "Get picking task details with shelf-mapped pick items" }
    },
    "/api/v1/picking/tasks/{taskId}/start": {
      "post": {
        "summary": "Assign picker and start picking task",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/picking/tasks/{taskId}/items/{itemId}/confirm": {
      "post": {
        "summary": "Confirm picked item quantity and atomically consume reserved stock",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/picking/tasks/{taskId}/items/{itemId}/report-exception": {
      "post": {
        "summary": "Report missing or damaged item and release unfulfilled reserved stock",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/picking/tasks/{taskId}/fail": {
      "post": {
        "summary": "Fail picking task and release all unconsumed reserved inventory",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string" } }]
      }
    },
    "/api/v1/simulation/runs/{id}/kpis": {
      "get": {
        "summary": "Retrieve or compute event-derived KPI evaluation summary for a completed simulation run",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Simulation Run ID" }
        ],
        "responses": {
          "200": {
            "description": "Evaluation summary with event-derived KPIs and synthetic scenario disclaimer",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/EvaluationSummary" } } } } }
          },
          "400": { "description": "Run is in progress or not in terminal state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "404": { "description": "Simulation run not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/api/v1/evaluation/compare": {
      "post": {
        "summary": "Execute fair comparison between baseline and candidate simulation evaluations",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompareRunsRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Comparison report detailing deltas, percentage changes, and improvement directions",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ComparisonReport" } } } } }
          },
          "400": { "description": "Validation error on payload", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
          "404": { "description": "One or both simulation runs not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    }
  }
}
